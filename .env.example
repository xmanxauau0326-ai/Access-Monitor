# ===== Access Monitor 環境変数テンプレート =====
# このファイルを .env にコピーして値を埋めてください。.env は Git にコミットしないこと。

# --- Supabase ---
SUPABASE_URL=https://tjrlshkuwsfbvttqrafg.supabase.co
# サーバー専用の鍵はこの1つだけです（Secret key / 旧 service_role）。
# 2026年以降の新形式は sb_secret_... です。
SUPABASE_SERVICE_ROLE_KEY=5c2bfc2abee47feea09a24a3cabaa177a87d8c9e1c1a9076bad299ca6c846992
# 匿名鍵（anon / sb_publishable_...）はサーバーでは使いません。設定しないでください。

# --- Flask ---
SECRET_KEY=change-me-to-a-random-32char-string
FLASK_ENV=production
PORT=5000

# --- 管理者認証 ---
ADMIN_TOKEN=change-me-to-a-strong-token

# --- MaxMind (月1回の自動更新を使う場合のみ) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- CORS ---
ALLOWED_ORIGINS=https://your-dashboard.vercel.app,http://localhost:3000

# --- 保持期間 ---
RETENTION_DAYS=31
